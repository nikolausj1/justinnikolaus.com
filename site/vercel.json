{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/printer/(.*)",
      "destination": "https://papertelegram.com/",
      "permanent": true
    },
    {
      "source": "/printer",
      "destination": "https://papertelegram.com/",
      "permanent": true
    },
    {
      "source": "/airhockey",
      "destination": "https://nikolausj1.github.io/two-ipad-air-hockey/",
      "permanent": true
    },
    {
      "source": "/airhockey/(.*)",
      "destination": "https://nikolausj1.github.io/two-ipad-air-hockey/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.justinnikolaus.com"
        }
      ],
      "destination": "https://justinnikolaus.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico|mp4|webm|woff|woff2|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
