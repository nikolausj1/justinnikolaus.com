{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/new",
      "destination": "/new/",
      "statusCode": 301
    },
    {
      "source": "/printer/(.*)",
      "destination": "https://papertelegram.com/",
      "permanent": true
    },
    {
      "source": "/printer",
      "destination": "https://papertelegram.com/",
      "permanent": true
    },
    {
      "source": "/airhockey",
      "destination": "https://nikolausj1.github.io/two-ipad-air-hockey/",
      "permanent": true
    },
    {
      "source": "/airhockey/(.*)",
      "destination": "https://nikolausj1.github.io/two-ipad-air-hockey/",
      "permanent": true
    },
    {
      "source": "/makerspace",
      "destination": "/makerspace/",
      "statusCode": 301
    },
    {
      "source": "/misc",
      "destination": "/misc/",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.justinnikolaus.com"
        }
      ],
      "destination": "https://justinnikolaus.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/misc/:file(knob-jolly|knob-suck|work-baseball-card)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        }
      ]
    },
    {
      "source": "/misc/:file(movie-poster-40-year-old|movie-poster-nacho-libre|movie-poster-stepbrothers|movie-poster-wolverine)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico|mp4|webm|woff|woff2|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/claw/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
